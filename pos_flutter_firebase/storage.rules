rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isBusinessMember(businessId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId == businessId;
    }

    // Respaldos subidos por la app (backups/<businessId>/...).
    match /backups/{businessId}/{allPaths=**} {
      allow read, write: if isBusinessMember(businessId);
    }
  }
}